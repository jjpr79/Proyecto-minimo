rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isTenantMember(tenantId) {
      return isSignedIn() && exists(/databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid));
    }
    
    function getMemberRole(tenantId) {
      let path = /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
      return exists(path) ? get(path).data.role : null;
    }

    function isValidTenant(data) {
      return data.name is string &&
             data.createdBy is string &&
             data.createdAt is timestamp;
    }

    function isValidMember(data) {
      return data.userId is string &&
             data.role in ['admin', 'member'] &&
             data.joinedAt is timestamp;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /admins/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
      allow delete: if isAdmin() && userId != request.auth.uid;
    }

    match /users/{userId} {
      allow list, read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /tenants/{tenantId} {
      allow read: if isSignedIn() && (
        ('createdBy' in resource.data && resource.data.createdBy == request.auth.uid) || 
        ('memberIds' in resource.data && request.auth.uid in resource.data.memberIds) ||
        isTenantMember(tenantId) || 
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid && isValidTenant(request.resource.data);
      allow update: if getMemberRole(tenantId) == 'admin' || isAdmin();
      allow delete: if getMemberRole(tenantId) == 'admin' || isAdmin();
      
      match /members/{userId} {
        allow read: if isTenantMember(tenantId) || (isSignedIn() && (('userId' in resource.data && resource.data.userId == request.auth.uid) || request.auth.uid == userId)) || isAdmin();
        allow create: if isSignedIn() && isValidMember(request.resource.data) && (
          getMemberRole(tenantId) == 'admin' || 
          isAdmin() ||
          (
            request.auth.uid == userId && (
              (existsAfter(/databases/$(database)/documents/tenants/$(tenantId)) &&
               getAfter(/databases/$(database)/documents/tenants/$(tenantId)).data.createdBy == request.auth.uid) ||
              (exists(/databases/$(database)/documents/tenants/$(tenantId)) &&
               get(/databases/$(database)/documents/tenants/$(tenantId)).data.createdBy == request.auth.uid)
            )
          )
        );
        allow update, delete: if getMemberRole(tenantId) == 'admin' || isAdmin();
      }
    }

    // Consultas de grupo de colecciones (collectionGroup('members'))
    match /{path=**}/members/{memberId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }
  }
}

